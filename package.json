{
  "name": "content-resourcer",
  "private": true,
  "scripts": {
    "build": "pnpm --filter @content-resourcer/db build && pnpm --filter @content-resourcer/worker build && pnpm --filter @content-resourcer/web build",
    "dev": "pnpm --filter @content-resourcer/db build && pnpm --parallel --filter @content-resourcer/web --filter @content-resourcer/worker dev",
    "dev:web": "pnpm --filter @content-resourcer/web dev",
    "dev:worker": "pnpm --filter @content-resourcer/worker dev",
    "lint": "pnpm -r run lint",
    "seed": "pnpm --filter @content-resourcer/db exec tsx src/seed.ts"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  },
  "packageManager": "pnpm@9.15.4"
}
